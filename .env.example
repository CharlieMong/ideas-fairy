# Copy to .env (gitignored) and fill in. NEVER put real values in this file —
# .env.example is committed; .env is not. Secrets are read from the environment.

# Discord webhook the digest is posted to (secret — keep it in .env only).
IDEAS_FAIRY_DISCORD_WEBHOOK=

# Local model endpoint (OpenAI-compatible). Ollama = 11434, llama-server = 8080.
IDEAS_FAIRY_LLM_BASE_URL=http://localhost:11434/v1
IDEAS_FAIRY_LLM_MODEL=qwen2.5:14b-instruct
# Only if your endpoint requires auth (blank for local):
IDEAS_FAIRY_LLM_API_KEY=

# Optional: GitHub token raises rate limits for the github source (read-only).
IDEAS_FAIRY_GITHUB_TOKEN=

# Optional web-search source (opt-in). Provide a key to enable it.
IDEAS_FAIRY_SEARCH_API_KEY=

# Optional: Reddit app-only OAuth (reliable reads; public JSON is often 403'd).
# Create a "script" app at https://www.reddit.com/prefs/apps -> use its id + secret.
IDEAS_FAIRY_REDDIT_CLIENT_ID=
IDEAS_FAIRY_REDDIT_CLIENT_SECRET=
IDEAS_FAIRY_REDDIT_USER_AGENT=ideas-fairy/0.1 by /u/yourname
